.{
    .name = .h2,
    .version = "0.0.0",
    .fingerprint = 0x242aa2d0b70b78fa, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    // One dependency, and the policy it replaces is worth stating rather than
    // quietly dropping. This package used to say "zero dependencies beyond the
    // Zig toolchain"; it now says **no dependency outside the organisation, and
    // none that pulls in a runtime or a libcrypto**. hpack is a
    // zero-dependency codec, so the graph stays one deep.
    //
    // What moved and why: HPACK is RFC 7541, and RFC 9204 adopts two of its
    // pieces unchanged — section 4.1.1 takes the prefixed integer and section
    // 4.1.2 takes the Huffman code, with the same 257-symbol table. Keeping
    // them here would have meant a second copy of a 900-line vectorised
    // decoder in zoxy-io/h3, where a bug fixed in one stays live in the other.
    // HPACK went whole rather than in pieces so that the package holding it is
    // named for what it holds.
    //
    // This package re-exports it as `h2.hpack`, which is the spelling zoxy and
    // zrk already use, so nothing downstream had to change.
    .dependencies = .{
        .hpack = .{
            .url = "git+https://github.com/zoxy-io/hpack#e627db06ae0c8e13269ff0b1408f5bb95edaca31",
            .hash = "hpack-0.0.0-rFnmJ56YAwB60V75llyS-laQLcbknwnHJH2yHIVoHI3U",
        },
    },
    // What ships to a consumer. `corpus/`, `fuzz/`, `bench/` and `scripts/`
    // are gates rather than library.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
