.{
    .name = .h2,
    .version = "0.0.0",
    .fingerprint = 0x242aa2d0b70b78fa, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    // Zero dependencies beyond the Zig toolchain, and this stays empty:
    // `scripts/lint.zig` forbids `@cImport`, and every buffer is caller-owned,
    // so there is nothing left for a dependency to provide.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
